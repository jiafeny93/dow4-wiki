---
/**
 * NativeBanner — Adsterra native banner (cards) at the end of articles.
 *
 * Loads /ads/native-banner.html in an isolated iframe. The env var
 * PUBLIC_AD_NATIVE_BANNER gates rendering: empty = no ad.
 */
const adKey = import.meta.env.PUBLIC_AD_NATIVE_BANNER;
---
{
  adKey && (
    <div class="my-10 flex flex-col items-center">
      <span class="mb-1 text-[10px] uppercase tracking-wider text-muted-foreground">Advertisement</span>
      <iframe
        src="/ads/native-banner.html"
        width="100%"
        height="340"
        scrolling="no"
        loading="lazy"
        sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox allow-forms"
        style="border:none; margin:0; padding:0; max-width: 728px;"
        title="advertisement native"
        aria-hidden="true"></iframe>
    </div>
  )
}
