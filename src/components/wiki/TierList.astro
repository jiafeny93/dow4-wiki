---
/**
 * TierList — visual S/A/B/C tier card list.
 *
 * Tier lists are the most-shared wiki artifact (Reddit/Discord traffic
 * flywheel). This component renders color-coded tier rows with item cards
 * and one-line reasoning — designed for faction/unit/build rankings.
 *
 * Pure static markup (shareable, fast); no JS. Items are plain strings or
 * `{ name, note }` objects.
 *
 * Usage in MDX:
 *   import TierList from '~/components/wiki/TierList.astro';
 *   <TierList tiers={[{ tier: 'S', items: [{ name: 'Space Marines', note: 'Complete toolkit' }] }]} />
 */
interface Item {
  name: string;
  note?: string;
}
interface Props {
  tiers: { tier: string; items: (string | Item)[] }[];
  /** Small caption under the list (e.g. "Pre-launch reading — updated with data Dec 3"). */
  caption?: string;
}
const { tiers, caption } = Astro.props;

const tierStyles: Record<string, string> = {
  S: 'bg-red-500/15 text-red-600 dark:text-red-400 border-red-500/40',
  A: 'bg-orange-500/15 text-orange-600 dark:text-orange-400 border-orange-500/40',
  B: 'bg-blue-500/15 text-blue-600 dark:text-blue-400 border-blue-500/40',
  C: 'bg-zinc-500/15 text-zinc-600 dark:text-zinc-400 border-zinc-500/40',
};
const normalize = (it: string | Item): Item => (typeof it === 'string' ? { name: it } : it);
---

<div class="not-prose my-8 overflow-hidden rounded-lg border border-border" data-tier-list>
  {tiers.map(({ tier, items }) => (
    <div class="flex border-b border-border last:border-b-0">
      <div
        class:list={[
          'flex w-14 shrink-0 items-center justify-center border-r border-border text-lg font-black',
          tierStyles[tier] ?? 'bg-muted text-muted-foreground border-border',
        ]}
        aria-label={`Tier ${tier}`}
      >
        {tier}
      </div>
      <div class="flex flex-1 flex-wrap gap-2 p-3">
        {items.map(normalize).map((it) => (
          <div class="min-w-[140px] flex-1 rounded-md border border-border bg-card px-3 py-2">
            <p class="text-sm font-semibold">{it.name}</p>
            {it.note && <p class="mt-0.5 text-xs text-muted-foreground">{it.note}</p>}
          </div>
        ))}
      </div>
    </div>
  ))}
  {caption && <p class="bg-muted/40 px-3 py-2 text-xs text-muted-foreground">{caption}</p>}
</div>
