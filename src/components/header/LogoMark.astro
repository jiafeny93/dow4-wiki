---
/**
 * LogoMark — original DoW4 Wiki emblem.
 *
 * Black-iron plate, bone-white roman "IV", a blood-red strike slash:
 * grimdark identity in brand colors (--brand #b91c1c family). Geometric
 * mark, no framework, scales via the class on the svg (h-4/h-5/h-6).
 * Original design — no Games Workshop trademarks.
 */
interface Props {
  class?: string;
}
const { class: className = 'h-6 w-6' } = Astro.props;
---

<svg viewBox="0 0 48 48" class={className} role="img" aria-label="DoW4 Wiki" xmlns="http://www.w3.org/2000/svg">
  <rect x="2" y="2" width="44" height="44" rx="10" fill="#15151a"></rect>
  <rect x="2" y="2" width="44" height="44" rx="10" fill="none" stroke="#b91c1c" stroke-width="2.5"></rect>
  <path d="M7 35 L41 12" stroke="#b91c1c" stroke-width="4" stroke-linecap="round" opacity="0.9"></path>
  <text
    x="24"
    y="31.5"
    text-anchor="middle"
    font-family="system-ui, -apple-system, 'Segoe UI', sans-serif"
    font-size="21"
    font-weight="900"
    letter-spacing="0.5"
    fill="#efe9dc">IV</text>
</svg>
